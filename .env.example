# ── 售后通环境变量示例 ──
# 复制为 .env(同目录)并按需修改:docker compose 会自动读取;
# Spring Boot 应用从进程环境变量读取(export 或 IDE 注入)。
# 所有变量在 application.yml / docker-compose.yml 中都有本地演示默认值,
# 不创建 .env 也能直接跑通本机演示。

# ── MySQL ──
# compose 容器 root 密码(与下方 MYSQL_PASSWORD 保持一致)
MYSQL_ROOT_PASSWORD=change-me-local
MYSQL_HOST=localhost
MYSQL_HOST_PORT=3307
MYSQL_PORT=3307
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me-local

# ── 应用 ──
SERVER_PORT=8080

# ── LLM(vLLM,OpenAI 兼容端点)──
LLM_API_KEY=none
LLM_BASE_URL=http://localhost:8000
LLM_MODEL=qwen3-4b-awq

# ── 嵌入服务(Infinity)──
EMBEDDING_BASE_URL=http://localhost:7997
EMBEDDING_MODEL=bge-small-zh-v1.5

# ── 向量库(Qdrant,gRPC 端口)──
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6336

# ── 飞书审批(可选;不启用时走网页审批中心 /approvals)──
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OWNER_OPEN_ID=
